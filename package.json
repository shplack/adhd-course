{
  "name": "alongside-adhd-course",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npm run test:unit && playwright test",
    "test:unit": "node --test tests/progress.test.js tests/course-data.test.js",
    "serve": "node scripts/serve.js",
    "watch": "node scripts/serve.js --watch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "node --check app.js && node --check progress.js && node --check course.js && npm run format:check"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.52.0",
    "prettier": "^3.5.3"
  }
}
